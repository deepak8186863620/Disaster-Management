# ===================================================================
# DisasterShield Environment Configuration
# ===================================================================

# 1. Google Gemini AI API (Required for live Gemini AI Risk Analysis)
# Get your free key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Firebase Realtime Firestore & Authentication (Optional for cloud sync)
# Get these in Firebase Console: https://console.firebase.google.com/
# Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_VAPID_KEY=your_firebase_vapid_key

# 3. Optional Backend / Cloud Functions URL
VITE_BACKEND_URL=http://localhost:5001/api/ai-risk-analysis
